{
  "name": "sitio-vale-do-cafe",
  "private": true,
  "version": "0.0.0",
  "description": "Maquete 3D interativa Sitio Vale do Cafe (fase 0: rede de seguranca)",
  "scripts": {
    "test": "node tests/run-all.js",
    "test:fast": "node tests/run-all.js --fast",
    "test:golden": "node tests/golden.js",
    "golden:update": "node tests/golden.js --update",
    "test:metrics": "node tests/metrics.js",
    "test:scenehash": "node tests/scenehash.js",
    "scenehash:update": "node tests/scenehash.js --update",
    "test:coplanar": "node tests/coplanar.js",
    "test:fp": "node tests/fp.js",
    "build": "vite build",
    "build:debug": "vite build --mode debug",
    "test:smoke": "node tests/smoke.js",
    "lint": "eslint --max-warnings 4 src tests/unit vitest.config.js",
    "format": "prettier --write src tests/unit vitest.config.js styles index.html",
    "format:check": "prettier --check src tests/unit vitest.config.js",
    "test:unit": "vitest run",
    "save": "node tools/save.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "pixelmatch": "^5.3.0",
    "playwright": "1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "3.9.10",
    "vite": "8.3.6",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.0"
  },
  "type": "module",
  "dependencies": {
    "three": "0.128.0"
  }
}
